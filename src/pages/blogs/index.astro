---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<Layout
  title="Blogs | Tenplant"
  description="TenplantのWeb Engineeringに関するブログ記事一覧です。"
>
  <h1 class="text-3xl font-bold">Blogs</h1>
  {
    posts.length > 0 ? (
      <ul class="mt-8 flex flex-col gap-6">
        {posts.map((post) => (
          <li>
            <a href={`/blogs/${post.id}/`} class="group block">
              <time
                datetime={post.data.publishedAt.toISOString().slice(0, 10)}
                class="text-sm text-zinc-500"
              >
                {post.data.publishedAt.toLocaleDateString("ja-JP", {
                  timeZone: "Asia/Tokyo",
                })}
              </time>
              <h2 class="mt-1 text-xl font-semibold group-hover:underline">
                {post.data.title}
              </h2>
              <p class="mt-1 text-zinc-600">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-zinc-600">記事は準備中です。</p>
    )
  }
</Layout>
