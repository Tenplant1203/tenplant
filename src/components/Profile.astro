---
import { Image } from "astro:assets";

import dogImage0934 from "../assets/IMG_0934.webp";
import dogImage2395 from "../assets/IMG_2395.webp";
import dogImage4097 from "../assets/IMG_4097.webp";
import dogImage7450 from "../assets/IMG_7450.webp";
import dogImage8351 from "../assets/IMG_8351.webp";
import dogImage8671 from "../assets/IMG_8671.webp";
import profileImage from "../assets/profile.webp";

const dogImages = [
  { src: dogImage0934, alt: "犬の写真" },
  { src: dogImage2395, alt: "犬の写真" },
  { src: dogImage4097, alt: "犬の写真" },
  { src: dogImage7450, alt: "犬の写真" },
  { src: dogImage8351, alt: "犬の写真" },
  { src: dogImage8671, alt: "犬の写真" },
];
---

<section aria-labelledby="profile-heading" class="text-center">
  <Image
    src={profileImage}
    alt="Tenplantのプロフィール画像"
    class="mx-auto mb-6 size-40 rounded-full"
    priority
    loading="eager"
  />
  <h1 id="profile-heading" class="text-2xl font-bold">
    Tenplant (Tenji Matsumoto)
  </h1>
  <div class="mt-3 flex items-center justify-center gap-3">
    <p>学生 / Web Front</p>
  </div>

  <nav aria-label="プロフィールリンク" class="mt-5 flex justify-center gap-4">
    <a
      href="https://github.com/tenplant1203"
      aria-label="GitHub"
      class="rounded-lg p-2 text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-950 focus-visible:ring-2 focus-visible:ring-zinc-500 focus-visible:outline-none dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-current">
        <path
          fill-rule="evenodd"
          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.15-1.11-1.458-1.11-1.458-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.58 9.58 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z"
          clip-rule="evenodd"></path>
      </svg>
      <span class="sr-only">GitHub</span>
    </a>
    <a
      href="https://x.com/tenplant1203"
      aria-label="X"
      class="rounded-lg p-2 text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-950 focus-visible:ring-2 focus-visible:ring-zinc-500 focus-visible:outline-none dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-current">
        <path
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817-5.967 6.817H1.68l7.73-8.835L1.025 2.25H7.85l4.713 6.231 5.681-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
        ></path>
      </svg>
      <span class="sr-only">X</span>
    </a>
    <a
      href="https://speakerdeck.com/tenplant1203"
      aria-label="Speaker Deck"
      class="rounded-lg p-2 text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-950 focus-visible:ring-2 focus-visible:ring-zinc-500 focus-visible:outline-none dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-6 fill-none stroke-current stroke-2"
      >
        <rect x="3" y="4" width="18" height="13" rx="2"></rect>
        <path
          d="M8 21h8M12 17v4M9 9l6 3-6 3V9Z"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="sr-only">Speaker Deck</span>
    </a>
  </nav>

  <div class="mx-auto mt-8 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-3">
    {
      dogImages.map(({ src, alt }, index) => (
        <button
          type="button"
          data-dog-image
          data-full-src={src.src}
          data-alt={alt}
          class="cursor-pointer rounded-xl bg-zinc-100 text-left transition-transform duration-300 ease-out hover:z-10 hover:scale-110 hover:shadow-xl focus-visible:ring-2 focus-visible:ring-zinc-500 focus-visible:outline-none active:scale-95 motion-reduce:transition-none dark:bg-zinc-900"
        >
          <Image
            src={src}
            alt={alt}
            loading="eager"
            class="aspect-square translate-y-3 scale-95 rounded-xl object-cover opacity-0 transition-all duration-700 ease-out motion-reduce:translate-y-0 motion-reduce:scale-100 motion-reduce:transition-none"
            style={`transition-delay: ${index * 80}ms`}
          />
        </button>
      ))
    }
  </div>

  <dialog
    id="dog-lightbox"
    class="m-auto max-h-[90vh] max-w-[90vw] rounded-2xl bg-transparent p-0 backdrop:bg-black/70"
  >
    <div
      class="relative flex max-h-[90vh] max-w-[90vw] items-center justify-center"
    >
      <form method="dialog" class="absolute top-3 right-3 z-10">
        <button
          type="submit"
          aria-label="画像を閉じる"
          class="rounded-full bg-black/70 px-3 py-1 text-xl text-white hover:bg-black/90 focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none"
        >
          ×
        </button>
      </form>
      <img
        id="dog-lightbox-image"
        src=""
        alt=""
        class="max-h-[90vh] max-w-[90vw] scale-95 object-contain opacity-0 transition-all duration-500 ease-out"
      />
    </div>
  </dialog>
</section>

<script src="../scripts/dog-lightbox.ts"></script>
