---
import { Image } from "astro:assets";

import dogImage0934 from "../assets/IMG_0934.webp";
import dogImage2395 from "../assets/IMG_2395.webp";
import dogImage4097 from "../assets/IMG_4097.webp";
import dogImage7450 from "../assets/IMG_7450.webp";
import dogImage8351 from "../assets/IMG_8351.webp";
import dogImage8671 from "../assets/IMG_8671.webp";
import profileImage from "../assets/profile.webp";

const dogImages = [
  { src: dogImage0934, alt: "犬の写真" },
  { src: dogImage2395, alt: "犬の写真" },
  { src: dogImage4097, alt: "犬の写真" },
  { src: dogImage7450, alt: "犬の写真" },
  { src: dogImage8351, alt: "犬の写真" },
  { src: dogImage8671, alt: "犬の写真" },
];
---

<section aria-labelledby="profile-heading" class="text-center">
  <Image
    src={profileImage}
    alt="Tenplantのプロフィール画像"
    class="mx-auto size-40 rounded-full"
  />
  <h1 id="profile-heading">Tenplant</h1>
  <p class="font-bold">学生</p>
  <p>Web</p>

  <div class="mx-auto mt-8 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-3">
    {
      dogImages.map(({ src, alt }) => (
        <button
          type="button"
          data-dog-image
          data-full-src={src.src}
          data-alt={alt}
          class="rounded-xl bg-zinc-100 text-left transition-transform duration-300 ease-out hover:z-10 hover:scale-110 hover:shadow-xl focus-visible:ring-2 focus-visible:ring-zinc-500 focus-visible:outline-none motion-reduce:transition-none dark:bg-zinc-900"
        >
          <Image
            src={src}
            alt={alt}
            class="aspect-square rounded-xl object-cover opacity-0 transition-opacity duration-500 motion-reduce:transition-none"
          />
        </button>
      ))
    }
  </div>

  <dialog
    id="dog-lightbox"
    class="max-h-[90vh] max-w-[90vw] rounded-2xl bg-transparent p-0 backdrop:bg-black/70"
  >
    <div class="relative">
      <form method="dialog" class="absolute top-3 right-3 z-10">
        <button
          type="submit"
          aria-label="画像を閉じる"
          class="rounded-full bg-black/70 px-3 py-1 text-xl text-white hover:bg-black/90 focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none"
        >
          ×
        </button>
      </form>
      <img
        id="dog-lightbox-image"
        src=""
        alt=""
        class="max-h-[90vh] max-w-[90vw] object-contain"
      />
    </div>
  </dialog>
</section>

<script src="../scripts/dog-lightbox.ts"></script>
