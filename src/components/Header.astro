---
const navItems = [
  { title: "home", path: "/" },
  { title: "blogs", path: "/blogs" },
];
---

<header
  class="flex items-center justify-between border-b border-zinc-200 pb-4 dark:border-zinc-800"
>
  <a
    href="/"
    class="rounded-lg px-3 py-2 text-2xl font-bold hover:bg-zinc-100 dark:hover:bg-zinc-900"
    >Tenplant</a
  >
  <nav aria-label="メインナビゲーション">
    <ul class="flex gap-1">
      {
        navItems.map(({ title, path }) => (
          <li>
            <a
              href={path}
              class="block rounded-lg px-3 py-2 hover:bg-zinc-100 dark:hover:bg-zinc-900"
            >
              {title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
